ErrorDocument 404 "TEST 404"

# ============================================================
# QUANXI LIMITED - Apache URL Rewrite Rules
# Clean URLs (no .html extension)
# ============================================================

Options -Indexes
RewriteEngine On

# ----------------------------------------------------------
# 1. Redirect /index or /index.html to the root /
# ----------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L,NE]

# ----------------------------------------------------------
# 2. Redirect any URL ending in .html to the clean version
#    e.g. /about.html → /about  (301 permanent)
# ----------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(.*?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# ----------------------------------------------------------
# 3. Internally rewrite clean URLs to their .html file
#    Skip if the request is a real file or directory
#    (images, CSS, JS etc. are served normally)
# ----------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^.]+)$ $1.html [L]

# ----------------------------------------------------------
# 4. Custom error pages (optional)
# ----------------------------------------------------------
# ErrorDocument 404 /404.html
